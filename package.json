{
  "name": "game-launcher",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "check": "node scripts/sync-version.mjs --check && tsc --noEmit && vitest run && cargo test --manifest-path src-tauri/Cargo.toml",
    "build:local": "tauri build --config src-tauri/tauri.local.conf.json",
    "version": "node scripts/sync-version.mjs && git add src-tauri/Cargo.toml src-tauri/Cargo.lock"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@fontsource/noto-serif-jp": "^5.3.1",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@visx/axis": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/responsive": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
